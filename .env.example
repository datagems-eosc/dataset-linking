# Copy this file to .env and replace the placeholders with the values
# provided through the approved DataGEMS credential channel.
# Never commit .env or send the client secret by email/chat.
OIDC_CLIENT_ID=dataset-linking
OIDC_CLIENT_SECRET=replace-with-the-local-client-secret

# Optional: these defaults target the DataGEMS DEV environment.
# OIDC_TOKEN_URL=https://datagems-dev.scayle.es/oauth/realms/dev/protocol/openid-connect/token
# OIDC_SCOPE=datagems
# DATAGEMS_API_BASE_URL=https://datagems-dev.scayle.es
